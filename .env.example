# PostgreSQL connection string
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos24i?schema=public"

# Set to "true" when serving over HTTPS (production) so session cookies are Secure
COOKIE_SECURE="false"

# Seed credentials (only used by `npm run db:seed`). Change them, then change passwords after first login.
SEED_PLATFORM_ADMIN_USERNAME="24i.admin"
SEED_PLATFORM_ADMIN_PASSWORD="ChangeMe-24i!"
SEED_STORE_ADMIN_USERNAME="villagedairy.owner"
SEED_STORE_ADMIN_PASSWORD="ChangeMe-Owner!"

# Optional: enables the "Ask 24i" AI assistant (Anthropic API key, server-side only)
ANTHROPIC_API_KEY=""
